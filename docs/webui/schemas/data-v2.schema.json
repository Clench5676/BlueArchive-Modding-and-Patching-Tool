{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-v2.schema.json",
  "title": "App data format manifest",
  "type": "object",
  "properties": {
    "format": {
      "const": "app_data"
    },
    "format_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "min_reader_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "written_by": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "library_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "active_epoch": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "stores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          }
        },
        "required": [
          "path",
          "version"
        ]
      }
    },
    "data_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "library": {
      "type": "string"
    },
    "route_token": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "established": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "format_version",
    "min_reader_version",
    "written_by",
    "library_id",
    "active_epoch",
    "stores",
    "data_id",
    "library",
    "route_token"
  ]
}
