{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library-v2.schema.json",
  "title": "Mod library format manifest",
  "type": "object",
  "properties": {
    "format": {
      "const": "mod_library"
    },
    "format_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "min_reader_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "written_by": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "library_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "active_epoch": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "stores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          }
        },
        "required": [
          "path",
          "version"
        ]
      }
    },
    "sequence": {
      "type": "integer"
    },
    "memberships": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "data_epoch": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "baseline": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "required": [
          "token",
          "data_epoch",
          "path",
          "source",
          "baseline"
        ]
      }
    },
    "backups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
          },
          "data_epoch": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "library_epoch": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "sequence": {
            "type": "integer"
          }
        },
        "required": [
          "data_id",
          "data_epoch",
          "library_epoch",
          "sequence"
        ]
      }
    },
    "predecessor": {
      "type": [
        "string",
        "null"
      ]
    },
    "activated": {
      "type": "boolean"
    },
    "prerequisite": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "library_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "data",
        "token",
        "library_id"
      ]
    }
  },
  "required": [
    "format",
    "format_version",
    "min_reader_version",
    "written_by",
    "library_id",
    "active_epoch",
    "stores",
    "sequence",
    "memberships",
    "backups"
  ]
}
