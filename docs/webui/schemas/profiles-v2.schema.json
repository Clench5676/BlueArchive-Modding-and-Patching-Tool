{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profiles-v2.schema.json",
  "title": "Install configuration",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "folders": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "configured": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "alt": {
                  "type": "string"
                },
                "resource_type": {
                  "enum": [
                    "portrait",
                    "memorialLobby",
                    "chibi",
                    "other"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ]
            }
          },
          "built": {
            "type": "object"
          },
          "named_by": {
            "type": "object"
          },
          "updated": {
            "type": "object"
          },
          "dismissed": {
            "type": "object"
          },
          "hidden": {
            "type": "array"
          }
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "unfinished": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "install": {
            "type": "string"
          },
          "core": {
            "type": "string"
          },
          "why": {
            "enum": [
              "pending",
              "left",
              "stuck",
              "held"
            ]
          }
        },
        "required": [
          "install",
          "core",
          "why"
        ]
      }
    }
  },
  "required": [
    "version"
  ]
}
